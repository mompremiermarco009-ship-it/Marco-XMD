// events/connection.update.js
const fs = require("fs");
const path = require("path");
const autoJoin = require("./autoJoin"); // si tu veux garder l'auto-join

module.exports = {
    name: "connection.update",  // nom exact de l'événement Baileys
    async execute(sock, update, { config }) {
        const { connection } = update;
        if (connection === "open") {
            const myJid = sock.user.id.split(":")[0] + "@s.whatsapp.net";
            console.log(`✅ Connexion ouverte pour ${myJid}`);

            try {
                // --- Envoi de l'image de connexion ---
                const imagePath = path.join(__dirname, "../media/logoconnect.jpg");
                if (fs.existsSync(imagePath)) {
                    const imageBuffer = fs.readFileSync(imagePath);
                    await sock.sendMessage(myJid, {
                        image: imageBuffer,
                        caption: `> ╭━━━━━━━━━━━━━━━━⬣
> ┃➥ 🇭🇹✨ 𝐂𝐨𝐧𝐧𝐞𝐜𝐭𝐢𝐨𝐧 𝐞𝐟𝐟𝐞𝐜𝐭𝐮𝐞́ 🇭🇹
> ┣━━━━━━━━━━━━━━━━⬣
> ┃➥ 𝐌𝐀𝐑𝐂𝐎-𝐗𝐌𝐃 𝐞𝐬𝐭 𝐨𝐩𝐞𝐫𝐚𝐭𝐢𝐟 👹⚡
> ┃➥ 𝐔𝐭𝐢𝐥𝐢𝐬𝐞 *.menu* 𝐩𝐨𝐮𝐫 𝐯𝐨𝐢𝐫 𝐥𝐞𝐬 𝐜𝐨𝐦𝐦𝐚𝐧𝐝𝐞𝐬 😉
> ╰━━━━━━━━━━━━━━━━⬣
> Powered by ©Mr Marco`
                    });
                } else {
                    console.log("⚠️ media/logoconnect.jpg non trouvé");
                }

                // --- Envoi de l'audio de connexion ---
                const audioPath = path.join(__dirname, "../media/Phonk.mp3");
                if (fs.existsSync(audioPath)) {
                    const audioBuffer = fs.readFileSync(audioPath);
                    await sock.sendMessage(myJid, {
                        audio: audioBuffer,
                        mimetype: "audio/mpeg",
                        ptt: false
                    });
                    console.log("🎵 Musique de connexion envoyée");
                } else {
                    console.log("⚠️ media/Phonk.mp3 non trouvé");
                }

                // --- Actions automatiques (rejoindre groupe, etc.) ---
                if (typeof autoJoin === "function") {
                    await autoJoin(sock, myJid);
                }
            } catch (err) {
                console.error("❌ Erreur lors de l'envoi du message de connexion :", err);
            }
        }
    }
};
